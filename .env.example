# Prefer `sh scripts/configure.sh https://tcg.webwire.cloud` to generate secrets.
# Do not commit .env or use these placeholders in a running installation.
APP_VERSION=0.5.0
APP_ORIGIN=https://tcg.webwire.cloud
APP_DOMAIN=tcg.webwire.cloud
APP_BIND=127.0.0.1
APP_PORT=3000
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BOOTSTRAP_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Only enable this behind the supplied proxy (or a trusted proxy that sets X-Forwarded-For).
TRUST_PROXY=true
CATALOGUE_REQUEST_INTERVAL_MS=300

# Tracked cards: owned, wishlisted or planned in binders. No API key is needed.
PRICE_TRACKING_ENABLED=true
PRICE_REFRESH_HOURS=6
