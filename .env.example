# Prefer `sh scripts/configure.sh https://cardshelf.cloud` to generate secrets.
# Do not commit .env or use these placeholders in a running installation.
APP_VERSION=0.47.3
# upgrade.sh replaces this moving tag with the verified release digest.
CARDSHELF_IMAGE=ghcr.io/frankymcgee/cardshelf:stable
APP_ORIGIN=https://cardshelf.cloud
APP_DOMAIN=cardshelf.cloud
APP_BIND=127.0.0.1
APP_PORT=3000
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BOOTSTRAP_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Only enable this behind the supplied proxy (or a trusted proxy that sets X-Forwarded-For).
TRUST_PROXY=true
CATALOGUE_REQUEST_INTERVAL_MS=300

# Tracked cards: owned, wishlisted or planned in binders. No API key is needed.
PRICE_TRACKING_ENABLED=true
PRICE_REFRESH_HOURS=6

# Platform subscription invoices only. Card-sale payments remain between collectors.
MEMBERSHIP_ENFORCEMENT_ENABLED=false

# Existing installs: sh scripts/configure-integrations.sh (never rotate it casually).
CARDSHELF_INTEGRATION_KEY=

STRIPE_ENVIRONMENT=sandbox
STRIPE_BILLING_ENABLED=false

# Emergency stop for NEW checkout requests only; does not cancel renewals.
STRIPE_CHECKOUT_KILL_SWITCH=false
# STRIPE_ENVIRONMENT, STRIPE_BILLING_ENABLED and MEMBERSHIP_ENFORCEMENT_ENABLED
# are fallback defaults. After the first UI save, Subscription controls takes precedence.

# Postal endpoint is fixed to the deployed HTTPS service; credentials and sender are managed under More -> Emails.
POSTAL_ORIGIN=https://postal.cardshelf.cloud
# Emergency operational pause for the durable mail worker (normal enablement is managed in the UI).
EMAIL_WORKER_ENABLED=true

# Legacy SMTP fallback for existing installations only. New Postal setups use More -> Emails.
# Never put credentials in GitHub source.
RECOVERY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# starttls (usually 587) or tls (usually 465); TLS verification cannot be disabled.
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
